# Copy this file to `.env` (cp env.example .env) and fill in values.
#
# ── Echostash server (control plane) ───────────────────────────────────────
# Postgres connection (the docker-compose service is named "postgres")
DATABASE_URL=postgres://echostash:echostash@localhost:5432/echostash

# Redis (job queue, sessions). The docker-compose service is named "redis".
REDIS_URL=redis://localhost:6379

# Server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Run Drizzle migrations automatically on server start (set false in prod to run as a job)
MIGRATE_ON_START=true

# Web UI admin login (single-tenant self-host). Change this.
ADMIN_PASSWORD=changeme

# Secret used to sign session cookies. Generate a long random string.
SESSION_SECRET=please-change-me-to-a-long-random-string

# ── Central provider keys (used ONLY for interactive sandbox runs) ──────────
# CI / bulk eval runs use the PROJECT's own keys from CI secrets, never these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: point at a LiteLLM proxy (OpenAI-compatible) for the long tail of providers
LITELLM_BASE_URL=
LITELLM_API_KEY=
