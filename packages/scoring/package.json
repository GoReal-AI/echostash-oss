{
  "name": "@echostash/scoring",
  "version": "0.1.2",
  "description": "Isomorphic scorer engine for LLM evals: deterministic assertions (contains, regex, json-schema, ...) plus the scorer catalog shared by the runner and the UI.",
  "keywords": [
    "echostash",
    "llm",
    "prompt",
    "eval",
    "scorer",
    "assertion",
    "regression",
    "testing"
  ],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/scoring"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/scoring#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/shared": "workspace:*",
    "ajv": "^8.17.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
