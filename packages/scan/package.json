{
  "name": "@echostash/scan",
  "version": "0.1.2",
  "description": "Discovery-agnostic prompt manifest: hash prompt content, model and params, diff two manifests, and read or write baselines.",
  "keywords": ["echostash", "llm", "prompt", "eval", "manifest", "diff", "baseline", "regression"],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/scan"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/scan#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
