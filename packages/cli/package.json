{
  "name": "@echostash/cli",
  "version": "0.1.2",
  "description": "Audit an MCP server's tool surface, scan your code for LLM prompts, and gate regressions in CI. No API key, no server, no model calls.",
  "keywords": [
    "echostash",
    "llm",
    "prompt",
    "eval",
    "mcp",
    "model-context-protocol",
    "lint",
    "audit",
    "ci",
    "cli",
    "tool-surface"
  ],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/cli#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "echostash": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/google-vertex": "^2.2.27",
    "@ai-sdk/openai": "^1.3.24",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^4.3.19"
  },
  "//optionalDependencies": "Only `scan` needs ripgrep, and only `scan --scan-model` needs the AI SDKs. Both are loaded lazily, so `mcp audit` works even when these fail to install (@vscode/ripgrep downloads a binary in a postinstall hook, which breaks behind proxies and in air-gapped CI).",
  "devDependencies": {
    "@echostash/analyzer": "workspace:*",
    "@echostash/discovery": "workspace:*",
    "@echostash/llm": "workspace:*",
    "@echostash/mcp": "workspace:*",
    "@echostash/scan": "workspace:*",
    "@echostash/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
