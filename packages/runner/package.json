{
  "name": "@echostash/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stateless eval executor (data plane): provider layer + matrix execution + scorers. Runs as a worker, GitHub Action, or CLI command. (M3/M4/M5)",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/llm": "workspace:*",
    "@echostash/scoring": "workspace:*",
    "@echostash/shared": "workspace:*",
    "bullmq": "^5.80.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
