    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/scan": "workspace:*",
    "@echostash/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
