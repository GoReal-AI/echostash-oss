{
  "name": "@echostash/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MCP tool-surface discovery: connect over stdio or streamable HTTP, read tools/list, and map it onto the scan manifest.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
