{
  "name": "@echostash/mcp",
  "version": "0.1.2",
  "description": "Read an MCP server's tools/list into a typed tool surface (stdio or HTTP), and diff it against a committed baseline.",
  "keywords": [
    "echostash",
    "llm",
    "prompt",
    "eval",
    "mcp",
    "model-context-protocol",
    "tools",
    "tool-surface",
    "baseline"
  ],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/scan": "workspace:*",
    "@echostash/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
