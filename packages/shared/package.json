{
  "name": "@echostash/shared",
  "version": "0.1.0",
  "description": "Echostash's shared contract: zod schemas and types for prompts, MCP tool surfaces, audit reports, baselines and the server-runner eval protocol.",
  "keywords": ["echostash", "llm", "prompt", "eval", "zod", "schema", "mcp", "contract"],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/shared#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
