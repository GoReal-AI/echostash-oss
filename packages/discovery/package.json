{
  "name": "@echostash/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agentic, language-agnostic prompt discovery. The model analyzes the project and drives read-only tools (tree/grep/read) to locate prompts; we extract the verbatim text from disk.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/llm": "workspace:*",
    "@echostash/shared": "workspace:*",
    "ai": "^4.3.19",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
