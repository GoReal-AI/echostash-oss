{
  "name": "@echostash/analyzer",
  "version": "0.1.0",
  "description": "Deterministic checks and the Tool Surface Score for MCP tool definitions: confusable tools, undescribed params, thin descriptions, token budget. No model calls.",
  "keywords": [
    "echostash",
    "llm",
    "prompt",
    "eval",
    "mcp",
    "model-context-protocol",
    "lint",
    "audit",
    "tool-surface",
    "score"
  ],
  "license": "MIT",
  "author": "Yoad Elkayam (https://github.com/YoadElkayam)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoReal-AI/echostash-oss.git",
    "directory": "packages/analyzer"
  },
  "homepage": "https://github.com/GoReal-AI/echostash-oss/tree/main/packages/analyzer#readme",
  "bugs": "https://github.com/GoReal-AI/echostash-oss/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
