{
  "name": "@echostash/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Echostash control plane: API + registry + datasets + eval results.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup && mkdir -p dist/migrations && cp -r src/db/migrations/. dist/migrations/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@echostash/scoring": "workspace:*",
    "@echostash/shared": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^10.3.0",
    "@paralleldrive/cuid2": "^2.3.1",
    "bullmq": "^5.81.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
